VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Лише для локальної розробки з Firebase Emulator Suite; у production не застосовується.
VITE_FIREBASE_EMULATORS=false
# Публічний токен Mapbox (pk.*) для супутникової карти з 3D-рельєфом.
VITE_MAPBOX_ACCESS_TOKEN=

# HTTPS URL бекенду в production; порожнє значення використовує /api на домені сайту.
# У розробці Vite проксіює /api на localhost:4000.
VITE_API_BASE_URL=
