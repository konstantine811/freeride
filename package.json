{
  "name": "freeride-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tsx --test tests/content.test.ts tests/routeMaps.test.ts",
    "test:rules": "firebase emulators:exec --project demo-freeride --only firestore,storage \"node --test tests/firebase.rules.test.mjs\"",
    "test:admin": "npm --prefix ../backend run build && firebase emulators:exec --project demo-freeride --only auth,firestore,storage \"node tests/admin.e2e.mjs\""
  },
  "dependencies": {
    "axios": "^1.4.0",
    "firebase": "^10.14.1",
    "framer-motion": "^10.12.6",
    "mapbox-gl": "^3.32.0",
    "plyr": "^3.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^5.1.0"
  }
}
